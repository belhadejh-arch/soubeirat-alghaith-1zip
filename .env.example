# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://user:password@localhost:5432/soubeirat_alghaith

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Long random string used to sign JWT tokens (required)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_very_long_random_secret_here

# ─── Session ──────────────────────────────────────────────────────────────────
# Used for HTTP session signing (required)
SESSION_SECRET=another_random_secret_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
